# Skill Intelligence Engine Configuration
# Copy this file to .env and fill in your values

# SearXNG Search Host
SEARX_HOST=https://sear.techpranee.com

# Ollama Configuration
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_BASE_URL=https://ollama2.havenify.ai

# Optional: Ollama API Key (only if your instance requires authentication)
# OLLAMA_API_KEY=

# Number of search results to fetch (default: 10)
NUM_RESULTS_DEFAULT=10